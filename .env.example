# ---------------------------------------------------------------------------
# Application
# For production: APP_ENV=production, APP_DEBUG=false, an https APP_URL,
# then run `php artisan key:generate` once.
# ---------------------------------------------------------------------------
APP_NAME="My Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://pos.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳

APP_MAINTENANCE_DRIVER=file

# Public self sign-up. Keep false: staff accounts are created by an admin under Users.
USER_REGISTRATION_ALLOWED=false

# First admin account created by `php artisan db:seed --class=UserTableSeeder`
# (leave ADMIN_PASSWORD empty to have a random one generated and printed once)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging — daily files, 14 days kept; raise to "debug" only while troubleshooting
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=pos
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / cache / queue
# SESSION_SECURE_COOKIE=true requires HTTPS.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=pos_

# Redis is recommended for cache/session/queue on busy installs
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (password reset links). SMTP can also be set in Settings → Email.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
